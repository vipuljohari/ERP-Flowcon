rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }

    function isActive() {
      return isSignedIn() && myProfile().active == true;
    }

    function isAdmin() {
      return isActive() && myRole() == 'admin';
    }

    // --- User Master ---
    // Only Admins can list/create/edit user profiles. A signed-in user may
    // read their own profile (needed at login to discover their own role).
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // 'pendingDevices' — self-filed device-approval request (see
      // AuthContext.tsx). 'activeDeviceToken'/'activeSessionAt' — the
      // single-active-session lock: claimed by a device on login, released
      // by the same user on a clean Log Out (Admin can also release it
      // for anyone via User Master).
      allow write: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingDevices', 'activeDeviceToken', 'activeSessionAt'])
      );
    }

    // --- Company Master ---
    // Branding (name/address) needs to be visible on the Login screen too,
    // before anyone is signed in — this data isn't sensitive (it's already
    // printed on invoices sent to customers), so read is public. Only
    // Admins can edit it.
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Business data (Phase 2) ---
    // Store owns physical stock: parts (item master), rawMaterials, and both
    // inward logs. Accounts owns sales/dispatch (also written by the Tally
    // connector script). PPC edits schedules — which currently live nested
    // inside each `parts/{id}` document — so PPC needs write access on
    // `parts` too; see the note in types.ts if you split schedules out later.
    // Admin can always do everything (isAdmin() short-circuits every check).

    match /parts/{partId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'store' || myRole() == 'ppc';
    }

    match /sales/{saleId} {
      allow read: if isActive();
      // Bug fix: Store's own Daily Dispatch screen (dispatch_daily, granted
      // to the 'store' role in types.ts) writes directly to this collection
      // when posting a dispatch — but 'store' was missing from this rule, so
      // every dispatch a Store user posted had its stock decrement succeed
      // (parts write is allowed) while the matching sales record was
      // silently rejected and reverted by the live listener. Adding 'store'
      // here matches what the app has always required it to be able to do.
      allow write: if isAdmin() || myRole() == 'accounts' || myRole() == 'store';
    }

    match /inwardLogs/{logId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'store';
    }

    match /rawMaterials/{rmId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'store';
    }

    // RM opening balances — same ownership as rawMaterials (Store enters
    // physical stock counts). A single settings-style document, not a
    // per-record collection.
    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'store';
    }

    match /rmInwardLogs/{logId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'store';
    }

    match /customers/{customerId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'accounts';
    }

    // Items the Tally connector script couldn't auto-match to a part —
    // written by the server-side script (Admin SDK, bypasses rules), read
    // here so Accounts/Admin can see and resolve them in the app.
    match /importIssues/{issueId} {
      allow read: if isActive();
      allow delete: if isAdmin() || myRole() == 'accounts';
      allow write: if isAdmin();
    }

    // RM Cross-Bill Check — manufacturer invoices, customer cross-invoices,
    // and the material length lookup, all owned by Accounts (purchase-side
    // reconciliation, same ownership as Customer Master / Sales).
    match /rmManufacturerInvoices/{docId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'accounts';
    }
    match /rmCustomerCrossInvoices/{docId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'accounts';
    }
    match /rmMaterialLengths/{docId} {
      allow read: if isActive();
      allow write: if isAdmin() || myRole() == 'accounts';
    }

    match /archives/{archiveId} {
      // Monthly archives are generated by the app's own rollover logic for
      // any signed-in role; nothing sensitive enough to restrict writes further.
      allow read, write: if isActive();
    }

    // Admin-only Notifications feed (see App.tsx's pushAdminAlert /
    // Notifications.tsx). Any active role can FILE a new alert — that's the
    // whole point, Store/Accounts/PPC are the ones triggering Discrepancy
    // Entries, RM Inward, manual Dispatch, and Tally imports — but only
    // Admin can read the feed, verify an entry, or delete one.
    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
